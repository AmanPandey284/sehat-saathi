APP_NAME=MediKiosk
ENVIRONMENT=development
# Local development origins. In Render, replace this value with the deployed Vercel URL:
# FRONTEND_ORIGIN=https://sehat-saathi-09.vercel.app
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Optional: enables live evidence-grounded summarization. Without it the app uses a deterministic evidence-first fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
